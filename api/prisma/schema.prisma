generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  // Délais de rappel en jours avant l'échéance (ex: J-15 et J-1)
  reminderLeadDays   Int[]               @default([15, 1])
  preferredVet       String?
  preferredVetPhone  String?
  preferredVetAddress String?
  createdAt          DateTime            @default(now())
  animals            Animal[]
  refreshTokens      RefreshToken[]
  passwordResetCodes PasswordResetCode[]
  pushTokens         PushToken[]
  householdMembers   HouseholdMember[]
  documents          Document[]
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetCode {
  id          String    @id @default(uuid())
  codeHash    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model HouseholdMember {
  id        String   @id @default(uuid())
  name      String
  role      String   @default("Peut modifier")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

model Animal {
  id            String         @id @default(uuid())
  name          String
  species       String
  breed         String?
  gender        Gender?
  isSterilized  Boolean        @default(false)
  dailyRation   String?
  foodBrand     String?
  foodStockKg   Float?
  foodTotalKg   Float?
  foodOpenedAt  DateTime?
  birthDate     DateTime?
  photoUrl      String?
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  healthEvents  HealthEvent[]
  weightRecords WeightRecord[]
  routines      Routine[]
  documents     Document[]
  createdAt     DateTime       @default(now())

  @@index([ownerId])
}

enum HealthEventType {
  VACCINE
  TREATMENT
  VISIT
}

model HealthEvent {
  id          String          @id @default(uuid())
  type        HealthEventType
  title       String
  date        DateTime
  dosage      String?
  vet         String?
  notes       String?
  nextDueDate DateTime?
  animalId    String
  animal      Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@index([animalId])
  @@index([nextDueDate])
}

model WeightRecord {
  id        String   @id @default(uuid())
  weightKg  Float
  date      DateTime @default(now())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
}

model Routine {
  id          String     @id @default(uuid())
  title       String
  description String?
  frequency   String     // e.g., "DAILY", "WEEKLY", "MONTHLY"
  animalId    String
  animal      Animal     @relation(fields: [animalId], references: [id], onDelete: Cascade)
  taskLogs    TaskLog[]
  createdAt   DateTime   @default(now())

  @@index([animalId])
}

model TaskLog {
  id        String   @id @default(uuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  isDone    Boolean  @default(false)
  doneBy    String?

  @@index([routineId])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("Carnets")
  fileUrl   String?
  fileSize  String?
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([animalId])
}
